# Committed on purpose. Vitest runs in mode `test`, and Vite loads
# `.env.test` after `.env`/`.env.local`, so these values win during tests —
# on this machine and on CI alike. Tests therefore never depend on whatever
# happens to be in a developer's personal `.env`.
#
# Nothing secret belongs here. The two base URLs are public, and the token is
# a placeholder: no test performs a real network request, `fetch` is mocked.

VITE_TMDB_TOKEN=test-token
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
